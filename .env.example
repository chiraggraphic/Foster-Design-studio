FOSTER_API_KEY=change-me-long-random-string      # required; the dashboard asks for this
# If the gateway runs in Docker, use http://host.docker.internal:PORT for engines on your machine.
COMFYUI_URL=http://host.docker.internal:8188
COMFY_CHECKPOINT=sd_xl_base_1.0.safetensors      # a checkpoint file inside ComfyUI/models/checkpoints
VOICE_URL=http://host.docker.internal:8100
STT_URL=http://host.docker.internal:3900
OPENWA_URL=http://host.docker.internal:2785
OPENWA_API_KEY=
OPENWA_SESSION=                                   # session id from OpenWA
BOSS_WHATSAPP=                                    # e.g. 919XXXXXXXXX (country code, no +)

# Designer tools
AGENCY_NAME=Foster Creative Agency
AGENCY_CONTACT=                                  # phone / email / address printed on quotations
CURRENCY=Rs.
LLM_URL=http://host.docker.internal:11434        # Ollama, for captions / briefs / client replies
LLM_MODEL=llama3.2
REMBG_MODEL=isnet-general-use                    # background-removal model; check a model's licence before changing it
AGENCY_ABOUT=                                    # one or two lines about your studio for the pitch deck
AGENCY_SERVICES=Brand identity,Social media design,Print & packaging,Exhibition design,Video & reels   # comma separated; edit to your real services
